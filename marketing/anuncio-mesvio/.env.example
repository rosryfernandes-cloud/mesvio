# Copie este ficheiro para ".env" (na mesma pasta) e preencha. O .env nunca vai para o git.
# Chave da API: elevenlabs.io → foto de perfil (canto inferior esquerdo) → API Keys → Create API Key
ELEVENLABS_API_KEY=
# Voz escolhida: Voices → My Voices → a voz → "…" → Copy Voice ID
ELEVENLABS_VOICE_ID=
