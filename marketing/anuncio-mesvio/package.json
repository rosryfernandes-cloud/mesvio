{
  "name": "mesvio-anuncio",
  "private": true,
  "version": "1.0.0",
  "description": "Anúncio de 30 s da MESVIO (Remotion): 16:9 para o site e 9:16 para TikTok/Reels",
  "scripts": {
    "studio": "remotion studio",
    "render:16x9": "remotion render Mesvio16x9 out/mesvio-16x9.mp4",
    "render:9x16": "remotion render Mesvio9x16 out/mesvio-9x16.mp4",
    "render": "npm run render:16x9 && npm run render:9x16",
    "typecheck": "tsc --noEmit",
    "render:som": "remotion render Mesvio16x9ComSom out/mesvio-16x9-som-provisorio.mp4 && remotion render Mesvio9x16ComSom out/mesvio-9x16-som-provisorio.mp4",
    "render:campanhas": "sh scripts/exportar-campanhas.sh",
    "render:pov": "remotion render MesvioPOV9x16 out/mesvio-pov-9x16.mp4",
    "sons": "node scripts/gerar-sons.mjs",
    "voz": "sh scripts/gerar-voz.sh",
    "voz:listar": "node scripts/voz-elevenlabs.mjs --listar",
    "voz:ia": "node scripts/voz-elevenlabs.mjs",
    "voz:campanhas": "node --experimental-strip-types --no-warnings scripts/voz-campanhas.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
