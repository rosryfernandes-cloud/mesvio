# ─── Aplicação ───────────────────────────────────────────────
# URL pública usada nos QR Codes / etiquetas NFC
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Base de dados (Supabase Postgres) — obrigatória em produção ─
# Pooler de transações (porta 6543) para a app; ligação direta (5432) para migrações
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ─── Supabase Auth (painel do staff) ─────────────────────────
# Sem estas variáveis, fora de produção, o painel entra em modo de desenvolvimento (utilizadores de demo).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Fila de envio ao POS — Fase 3 ───────────────────────────
# Sem DATABASE_URL em dev, a app usa PGlite em .data/pglite (nada a instalar).
# Em serverless: OUTBOX_WORKER=off e um cron a chamar /api/cron/outbox com este segredo.
OUTBOX_WORKER=
CRON_SECRET=

# ─── Segurança ───────────────────────────────────────────────
# Assinatura de cookies do painel (obrigatória em produção, mín. 32 caracteres): openssl rand -base64 48
SESSION_SECRET=
# Chave AES-256-GCM (32 bytes em base64) para credenciais POS: openssl rand -base64 32
POS_CREDENTIALS_KEY=
POS_CREDENTIALS_KEY_ID=k1
# Cifra dos segredos 2FA do painel central (32 bytes em base64): openssl rand -base64 32
PLATFORM_SECRET_KEY=
# Proxy à frente da app, de cujo cabeçalho se lê o IP do cliente: vercel | cloudflare | none
TRUSTED_PROXY=vercel
# Salt para pseudonimizar IPs (anti-abuso): openssl rand -base64 32
IP_HASH_SALT=

# ─── Integração POS ──────────────────────────────────────────
# mock | zonesoft (zonesoft indisponível até haver documentação oficial)
DEFAULT_POS_PROVIDER=mock

# ─── Observabilidade (opcional) ─────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── Pagamentos na mesa (Stripe Connect) ─────────────────────
# Sem estas variáveis, fora de produção, os pagamentos usam um fornecedor simulado.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Assinatura dos webhooks (Developers → Webhooks → endpoint /api/pagamentos/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# Opcional (antigo): forçar a conta ligada da demo. Normalmente o dono liga a conta no painel.
STRIPE_DEMO_CONNECTED_ACCOUNT=

# ─── Pedidos de demonstração da landing (opcional) ──────────
# Sem isto, os pedidos ficam só na tabela demo_requests. Com isto, a equipa recebe cada um por email (resend.com).
RESEND_API_KEY=
# Quem recebe (vários separados por vírgula)
DEMO_REQUESTS_TO=
# Remetente de um domínio verificado na Resend, ex.: MESVIO <ola@mesvio.pt>
DEMO_REQUESTS_FROM=
