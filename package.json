{
  "name": "restaurante-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:producao": "node --env-file=.env.production.local node_modules/drizzle-kit/bin.cjs migrate",
    "demo:urls": "node scripts/print-demo-urls.mjs",
    "demo:supabase": "tsx --conditions=react-server scripts/demo/criar-demo-supabase.ts",
    "admin:criar": "tsx scripts/admin/administradores.ts criar",
    "admin:repor-2fa": "tsx scripts/admin/administradores.ts repor-2fa",
    "admin:remover": "tsx scripts/admin/administradores.ts remover"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "drizzle-orm": "^0.45.3",
    "next": "^16.0.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.2.0"
  }
}
